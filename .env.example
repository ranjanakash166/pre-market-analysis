# LLM: omit AI_PROVIDER to auto-pick Anthropic if ANTHROPIC_API_KEY (or CLAUDE_API_KEY) is set, else Google if AI_API_KEY / GEMINI_API_KEY is set.
# Force one: AI_PROVIDER=anthropic | google | gemini
# AI_PROVIDER=google

# --- Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=replace_with_your_key
# Alias: CLAUDE_API_KEY=...
# e.g. claude-sonnet-4-6 (recommended), claude-opus-4-7, claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google GenAI (when explicit AI_PROVIDER=google, or when no Anthropic key is set) ---
# API key for @google/genai. Legacy alias: GEMINI_API_KEY.
AI_API_KEY=replace_with_new_key
# Model id. Legacy: GEMINI_MODEL.
AI_MODEL=gemini-2.5-flash

# --- Learn / courses (optional) ---
# Generate `content/courses/<videoId>.json` from YouTube captions + Gemini:
#   npm run learn:generate -- --url https://www.youtube.com/watch?v=VIDEO_ID
# Uses the same AI_API_KEY / GEMINI_API_KEY as above.

CRON_SECRET=replace_with_long_random_secret
# Vercel scheduled crons call cron routes with GET and send Authorization: Bearer <CRON_SECRET> when this is set.

# --- Postgres (X feed ingestion + analysis) — apply db/schema.sql to your database
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL is accepted as an alias. Vercel+Neon with a "STORAGE" prefix may set STORAGE_DATABASE_URL (supported).

# --- X API v2 (Bearer) — server only; https://developer.x.com/en/docs/twitter-api
# X_API_BEARER_TOKEN=

# Comma or whitespace separated handles (without @). Seeded into `monitored_accounts` on each sync cron.
# X_MONITOR_HANDLES=kyalashish

# Auth.js — https://authjs.dev/getting-started/installation
# Required for /api/auth/session (omit only in local dev where a built-in fallback applies).
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_secret
# Local: http://localhost:3000 — Production: your canonical site URL (must match Google OAuth redirect setup)
AUTH_URL=http://localhost:3000
# Trust host header on Vercel / reverse proxies
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification (credentials sign-up) via Resend — https://resend.com/
RESEND_API_KEY=
# Verified sender/domain in Resend, e.g. "Twickers <auth@yourdomain.com>"
AUTH_EMAIL_FROM=

# Razorpay (subscriptions + one-time checkout) — https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Stooq daily CSV API key (free — get from https://stooq.com/ after captcha).
# Improves pivot OHLC fetch if Yahoo is blocked; otherwise Yahoo (query1 + query2) is used alone.
STOOQ_API_KEY=
